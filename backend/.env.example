# Copy to .env (or set these as environment variables) - NEVER commit real values.
# Supabase -> Connect -> "Session pooler" -> JDBC string (works on IPv4 networks)
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.<your-project-ref>
DB_PASSWORD=<your database password>

JWT_SECRET=<a long random string, at least 40 characters>
OTP_DEV_MODE=true            # false once you configure SMS
ADMIN_PHONE=9999999999
ADMIN_EMAIL=admin@rentoindia.com
ADMIN_PASSWORD=Admin@12345   # change it!
SEED_DEMO_DATA=true

# optional, when you get the keys
SMS_PROVIDER=none            # msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CASHBACK_PERCENT=100         # % of rent credited back as coins (lower before going live)
